# ==============================================================================
# MULTI-PROVIDER ROUND-ROBIN CONFIGURATION FOR LANGGRAPH REACT AGENT
# ==============================================================================
# PostgreSQL is required for application state and LangGraph checkpoints.
DATABASE_URL=postgresql://orbit:change-me@localhost:5432/orbit
DATABASE_POOL_MAX_SIZE=10

# Private S3-compatible object storage is required for uploads and workspaces.
S3_BUCKET=orbit-private
S3_ENDPOINT_URL=https://<account-or-service-endpoint>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# You can define as many API keys as you want: API_KEY1, API_KEY2, API_KEY3, ...
# For each numbered index, configure:
#   API_KEY<N>       : (Required) API key for the endpoint
#   BASE_URL<N>      : (Optional) Base URL (e.g. OpenAI, Groq, OpenRouter, DeepSeek, Ollama)
#                      Defaults to https://api.openai.com/v1 if left blank
#   MODEL<N>         : (Optional) Primary model to use (defaults to 'gpt-4o-mini')
#   MODEL_LIST<N>    : (Optional) Comma-separated list of models supported by this endpoint
#   PROVIDER_NAME<N> : (Optional) Human-readable label for logs and tracking

# --- Provider 1: OpenAI Primary ---
PROVIDER_NAME1=OpenAI-Account-1
API_KEY1=sk-proj-your-first-openai-key-here
BASE_URL1=https://api.openai.com/v1
MODEL1=gpt-4o-mini
MODEL_LIST1=gpt-4o-mini,gpt-4o

# --- Provider 2: Groq ---
PROVIDER_NAME2=Groq-Inference
API_KEY2=gsk_your-groq-key-here
BASE_URL2=https://api.groq.com/openai/v1
MODEL2=llama-3.3-70b-versatile
MODEL_LIST2=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- Provider 3: OpenRouter ---
PROVIDER_NAME3=OpenRouter-Gateway
API_KEY3=sk-or-v1-your-openrouter-key-here
BASE_URL3=https://openrouter.ai/api/v1
MODEL3=deepseek/deepseek-chat
MODEL_LIST3=deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct

# --- Optional SMTP Settings for 6-Digit Email Verification Codes (ChatGPT/Claude style OTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Orbit Studio <noreply@example.com>

# --- Provider 4: Local Ollama / LM Studio (Optional) ---
PROVIDER_NAME4=Local-Ollama
API_KEY4=ollama
BASE_URL4=http://localhost:11434/v1
MODEL4=llama3.2
MODEL_LIST4=llama3.2,qwen2.5:7b

# --- Event-trigger account integrations (optional) ---
# Public HTTPS origin for provider callbacks and GitHub webhook delivery.
# Register the OAuth callback URLs shown below in each provider app.
# ORBIT_PUBLIC_URL=https://orbit.example.com
# Required for GitHub/Slack events: choose a finite positive limit for your deployment.
# ORBIT_PROVIDER_WEBHOOK_MAX_BYTES=
# Shared Fernet vault key for OAuth provider tokens, custom MCP credentials and
# marketplace password fields. Generate once and keep stable; startup migrates
# existing connector secrets to encrypted storage.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATION_TOKEN_ENCRYPTION_KEY=
#
# GitHub OAuth App. The account flow requests write:repo_hook so Orbit can
# install and remove a repository webhook for each GitHub event routine.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# Slack app OAuth v2. In Slack Event Subscriptions, set the Request URL to:
# https://<ORBIT_PUBLIC_URL>/api/integrations/slack/events
# Configure the Orbit-owned Slack app once with app_mention, message.channels,
# and reaction_added bot events plus app_mentions:read, channels:history,
# channels:read, groups:history, groups:read, and reactions:read bot scopes.
# After Slack verifies the Orbit event Request URL, set this flag to true in
# the backend environment. End users do not configure their own Slack apps.
# SLACK_EVENTS_READY=false
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
#
# Gmail OAuth app and authenticated Pub/Sub push setup.
# Grant gmail.readonly in the Google OAuth consent configuration.
# Create a Pub/Sub topic and grant Gmail permission to publish to it.
# Configure an authenticated push subscription targeting
# https://<ORBIT_PUBLIC_URL>/api/integrations/gmail/events. The audience and
# email must match the push subscription's OIDC token settings.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic-id>
# GMAIL_PUBSUB_AUDIENCE=https://<ORBIT_PUBLIC_URL>/api/integrations/gmail/events
# GMAIL_PUBSUB_PUSH_EMAIL=<push-service-account>@<project-id>.iam.gserviceaccount.com
# Bound work per notification. If a batch exceeds either limit, Orbit leaves
# its history cursor unchanged so Pub/Sub can retry it.
# ORBIT_GMAIL_HISTORY_PAGE_LIMIT=10
# ORBIT_GMAIL_MESSAGE_LIMIT=100
